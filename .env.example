# Copy this file to .env and fill in your own values. Never commit .env.

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=your-chosen-model-id-here

# --- OpenRouter (optional) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=10
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.3

# --- Database ---
DATABASE_URL=sqlite:///./footygpt.db

# --- Frontend ---
# URL of the FastAPI backend. API_BASE_URL takes precedence over BACKEND_URL.
API_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
