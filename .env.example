# Copy this file to .env and fill in your own values. Never commit .env.

# --- AI Provider Selection ---
# Set to "openrouter" or "gemini". Defaults to "openrouter".
AI_PROVIDER=openrouter

# Optional secondary AI provider used when the primary provider encounters a
# temporary failure. Empty means fallback is disabled.
# When set, it must differ from AI_PROVIDER and be one of: openrouter, gemini.
# Fallback may incur additional API charges depending on the selected model.
# The fallback provider must have valid API key and model configured.
AI_FALLBACK_PROVIDER=

# --- OpenRouter ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=your-chosen-model-id-here

# OpenRouter free models use the ":free" suffix, e.g. "openrouter/free" or
# "meta-llama/llama-3.1-8b-instruct:free". Verify current free models at
# https://openrouter.ai/models before selecting one.

# --- OpenRouter (optional) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=10
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.3

# --- Google Gemini ---
# Select a free-tier Gemini model. gemini-1.5-flash is an example; verify
# current free models and rate limits at https://ai.google.dev/pricing before
# selecting one. Model availability changes over time.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- LangSmith Observability ---
# Tracing is disabled by default. Set to "true" to enable.
LANGSMITH_TRACING=false
# Get your API key from https://smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=FootyGPT

# --- Database ---
DATABASE_URL=sqlite:///./footygpt.db

# --- Frontend ---
# URL of the FastAPI backend. API_BASE_URL takes precedence over BACKEND_URL.
API_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
